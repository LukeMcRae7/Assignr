{
  "expo": {
    "name": "Assignr",
    "slug": "assignr",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "assignr",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.assignr.student"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2798EE",
        "foregroundImage": "./assets/android-foreground.png",
        "monochromeImage": "./assets/android-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "app.assignr.student"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Assignr",
      "shortName": "Assignr",
      "description": "Courses, deadlines, and a clearer day."
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-localization"
    ]
  }
}
